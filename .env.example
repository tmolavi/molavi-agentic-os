# TM Molavi Agentic OS — Environment Configuration Template
# Copy this file to '.env' and populate with your own credentials.
# NEVER commit your real '.env' file or private API keys to version control!

# ==============================================================================
# 1. CORE OPERATIONAL SETTINGS
# ==============================================================================
TM_ENV=development
TM_LOG_LEVEL=INFO
TM_WORKSPACE_ROOT=./workspace

# Secret key used for signing cryptographic L2 HMAC human approval tickets
# Generate a secure key with: python3 -c "import secrets; print(secrets.token_hex(32))"
TM_HMAC_SECRET_KEY=replace-with-your-secure-random-hmac-key-min-32-chars

# ==============================================================================
# 2. LOCAL-FIRST & ZERO-COST MODEL PROVIDERS (RECOMMENDED)
# ==============================================================================
# Ollama Local Offline Models ($0.00 cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Groq Cloud Free Tier ($0.00 cost)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini Free Tier ($0.00 cost)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter Free Tier ($0.00 cost)
OPENROUTER_API_KEY=

# ==============================================================================
# 3. OPTIONAL COMMERCIAL CLOUD PROVIDERS (PAID FALLBACK ONLY)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# 4. TM MEMORY & SECOND BRAIN INTEGRATION
# ==============================================================================
# Local-first Markdown Second Brain Vault path (tm-second-brain)
TM_SECOND_BRAIN_VAULT_PATH=~/.tm-brain
TM_SECOND_BRAIN_NAMESPACE=default

# ==============================================================================
# 5. MCP (MODEL CONTEXT PROTOCOL) & TOOL GATEWAY
# ==============================================================================
TM_MCP_ENFORCE_BUMBLEBEE_SECURITY=true
TM_MCP_PORT=8765
TM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
