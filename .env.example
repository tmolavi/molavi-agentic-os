# TM Molavi Agentic OS — Environment Configuration Template
# IMPORTANT: This repository is 100% open-source and model-agnostic.
# NEVER commit real API keys, credentials, or private tokens to version control.
# Copy this file to .env and configure your local or cloud endpoints as needed.

# ==============================================================================
# 1. CORE OPERATING CONFIGURATION
# ==============================================================================
TM_ENV=development
TM_LOG_LEVEL=INFO
TM_WORKSPACE_DIR=./workspace
TM_ENABLE_TELEMETRY=false

# Secret key used for cryptographic HMAC-signed Approval Tickets (L2_HUMAN_APPROVAL)
# Generate a secure 32+ character key locally: python -c "import secrets; print(secrets.token_hex(32))"
TM_APPROVAL_HMAC_SECRET=replace_with_your_local_secure_secret_key_32chars

# ==============================================================================
# 2. FREE-FIRST MODEL ROUTING (ZERO-COST TIER — RECOMMENDED)
# ==============================================================================
# Local Ollama endpoint ($0.00 marginal cost)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Zero-cost Cloud Providers (Free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# 3. OPTIONAL COMMERCIAL CLOUD PROVIDERS (PAID FALLBACK ONLY)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# 4. PERSISTENT MEMORY & TM SECOND BRAIN
# ==============================================================================
TM_BRAIN_VAULT_PATH=~/.tm-brain
TM_BRAIN_DEFAULT_NAMESPACE=default

# ==============================================================================
# 5. MCP (MODEL CONTEXT PROTOCOL) & SECURITY BOUNDARIES
# ==============================================================================
TM_MCP_ENFORCE_BUMBLEBEE_SECURITY=true
TM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
